DB_PORT=5432 # db port

DB_NAME='' #db name

DB_USER=postgres # db user

DB_PASSWORD='' # db password

PORT=8000

JWT_SECRET=

# EXPENSIFY CUSTOM AUTH
EXPENSIFY_JWT_ACCESS_SECRET=
EXPENSIFY_JWT_REFRESH_SECRET=
EXPENSIFY_JWT_ACCESS_EXPIRY=15m
EXPENSIFY_JWT_REFRESH_EXPIRY=30d

# SMTP (nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Expensify

# FIREBASE_STORAGE_BUCKET=

# Expo push notifications (expensify app) - generate at https://expo.dev/accounts/[account]/settings/access-tokens
EXPENSIFY_EXPO_PUSH_NOTIFICATION_ACCESS_TOKEN=

# Static token for the /notifications/test-send route (test/dev use only)
NOTIFICATION_TEST_TOKEN=

# Static token required by the GitHub Actions cron workflow to hit /crons routes
CRON_SECRET_TOKEN=